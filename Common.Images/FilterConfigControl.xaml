<UserControl x:Class="Common.Images.FilterConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SlimViewer;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="Filter Configuration" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>

        <!-- Top Filter Selection Card -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#383838" BorderThickness="1" CornerRadius="4"
                Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Selected Filter Type" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ComboBox Height="28"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Select the filter algorithm to configure" />
            </StackPanel>
        </Border>

        <!-- Parameters Settings Card -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#383838" BorderThickness="1" CornerRadius="4"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Factor -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Factor" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsFactorActive}"
                             ToolTip="The multiplier applied to the pixel values" />

                    <!-- Bias -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Bias" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding Bias, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBiasActive}"
                             ToolTip="The offset added to the pixel values (Brightness shift)" />

                    <!-- Sigma -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sigma" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Row="4" Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding Sigma, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsSigmaActive}"
                             ToolTip="Standard deviation for blur kernels (Gaussian)" />

                    <!-- Base Window Size -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Base Window Size" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Row="6" Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding BaseWindowSize, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBaseWindowSizeActive}"
                             ToolTip="The area of effect for the filter (Kernel Size)" />

                    <!-- Scale -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Scale" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Row="8" Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsScaleActive}"
                             ToolTip="Final normalization factor" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Footer Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="💾 Save" Width="80" Margin="0,0,6,0" FontWeight="SemiBold"
                    Command="{Binding SaveCommand}" />
            <Button Content="🔄 Reset" Width="80" Margin="0,0,6,0" Command="{Binding ResetCommand}" />
        </StackPanel>
    </Grid>
</UserControl>