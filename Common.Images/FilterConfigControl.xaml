<UserControl x:Class="Common.Images.FilterConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converter="clr-namespace:Common.Converter;assembly=Common.Converter"
             mc:Ignorable="d"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--
                Collapse=True (not the default Hidden): an inactive parameter row should free up
                its space, not just go invisible while still holding a gap open. This is what
                lets "only show what applies to the selected filter" actually shrink the panel
                instead of leaving a wall of empty rows.
            -->
            <converter:BooleanToVisibilityConverter x:Key="CollapseIfInactiveConverter" Collapse="True" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SlimViewer;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="Filter Configuration" Style="{StaticResource SidePanelTitleStyle}" />
        </StackPanel>

        <!-- Top Filter Selection Card -->
        <Border Grid.Row="1" Style="{StaticResource SidePanelCardStyle}">
            <StackPanel>
                <TextBlock Text="Selected Filter Type" Style="{StaticResource SidePanelSectionHeaderStyle}"
                           Margin="0,0,0,6" />
                <ComboBox Height="28"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Select the filter algorithm to configure" />
            </StackPanel>
        </Border>

        <!-- Parameters Settings Card -->
        <Border Grid.Row="2" Style="{StaticResource SidePanelCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Parameters" Style="{StaticResource SidePanelSectionHeaderStyle}" />

                    <!--
                        Each parameter is its own row, individually collapsible. Previously these
                        used IsEnabled to grey out params the selected filter doesn't use, which
                        left every filter showing all 5 fields regardless - most of them inert.
                        Visibility now removes the row entirely (and its space, via
                        CollapseIfInactiveConverter) so picking a filter only shows what it
                        actually reads.
                    -->

                    <!-- Factor -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding IsFactorActive, Converter={StaticResource CollapseIfInactiveConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Factor" Style="{StaticResource ParameterLabelStyle}" />
                        <TextBox Grid.Column="1" Style="{StaticResource ParameterTextBoxStyle}"
                                 Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 ToolTip="The multiplier applied to the pixel values" />
                    </Grid>

                    <!-- Bias -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding IsBiasActive, Converter={StaticResource CollapseIfInactiveConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Bias" Style="{StaticResource ParameterLabelStyle}" />
                        <TextBox Grid.Column="1" Style="{StaticResource ParameterTextBoxStyle}"
                                 Text="{Binding Bias, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 ToolTip="The offset added to the pixel values (Brightness shift)" />
                    </Grid>

                    <!-- Sigma -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding IsSigmaActive, Converter={StaticResource CollapseIfInactiveConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sigma" Style="{StaticResource ParameterLabelStyle}" />
                        <TextBox Grid.Column="1" Style="{StaticResource ParameterTextBoxStyle}"
                                 Text="{Binding Sigma, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 ToolTip="Standard deviation for blur kernels (Gaussian)" />
                    </Grid>

                    <!-- Base Window Size -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding IsBaseWindowSizeActive, Converter={StaticResource CollapseIfInactiveConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Base Window Size" Style="{StaticResource ParameterLabelStyle}"
                                   TextWrapping="Wrap" />
                        <TextBox Grid.Column="1" Style="{StaticResource ParameterTextBoxStyle}"
                                 Text="{Binding BaseWindowSize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 ToolTip="The area of effect for the filter (Kernel Size)" />
                    </Grid>

                    <!-- Scale -->
                    <Grid Margin="0,0,0,0"
                          Visibility="{Binding IsScaleActive, Converter={StaticResource CollapseIfInactiveConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Scale" Style="{StaticResource ParameterLabelStyle}" />
                        <TextBox Grid.Column="1" Style="{StaticResource ParameterTextBoxStyle}"
                                 Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 ToolTip="Final normalization factor" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="💾 Save" Width="80" Margin="0,0,6,0" FontWeight="SemiBold"
                    Command="{Binding SaveCommand}" ToolTip="Persist these settings for this filter" />
            <Button Content="🔄 Reset" Width="80" Margin="0,0,6,0" Command="{Binding ResetCommand}"
                    ToolTip="Restore this filter's parameters to their defaults" />
        </StackPanel>
    </Grid>
</UserControl>