<UserControl x:Class="Common.Images.CifChannelEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converter="clr-namespace:Common.Converter;assembly=Common.Converter"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converter:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Grid.ColumnSpan="2" Padding="2" Background="#2D2D30" Foreground="White">
            <MenuItem Header="_File">
                <MenuItem Header="_Load Colormap (CIF)..." Click="LoadCif_Click" />
                <MenuItem Header="_Export Colormap (CIF)..." Click="ExportCif_Click" />
                <MenuItem Header="Export _Edited CIF..." Click="ExportEditedCif_Click" />
            </MenuItem>
        </Menu>

        <!-- Image Viewport -->
        <Border Grid.Row="1" Grid.Column="0" Margin="5" BorderThickness="1">
            <Image x:Name="Viewport" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <!-- Control Panel -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="5">
            <StackPanel Margin="5">

                <!-- Global Channel Adjustments -->
                <Expander Header="Global Channel Offsets" IsExpanded="False" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding ElementName=Root, Path=RedOffset, StringFormat=Red Offset: {0}}" />
                        <Slider x:Name="RedSlider" Minimum="-255" Maximum="255"
                                Value="{Binding Path=RedOffset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,2,0,8" />

                        <TextBlock Text="{Binding ElementName=Root, Path=GreenOffset, StringFormat=Green Offset: {0}}" />
                        <Slider x:Name="GreenSlider" Minimum="-255" Maximum="255"
                                Value="{Binding Path=GreenOffset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,2,0,8" />

                        <TextBlock Text="{Binding ElementName=Root, Path=BlueOffset, StringFormat=Blue Offset: {0}}" />
                        <Slider x:Name="BlueSlider" Minimum="-255" Maximum="255"
                                Value="{Binding Path=BlueOffset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,2,0,8" />
                    </StackPanel>
                </Expander>

                <!-- Color Isolation & Remapping -->
                <Expander Header="Palette Isolation &amp; Remap" IsExpanded="True">
                    <StackPanel Margin="5">
                        <CheckBox x:Name="IsolateCheckBox" Content="Enable Color Isolation Mode"
                                  Checked="OnIsolationModeChanged" Unchecked="OnIsolationModeChanged" Margin="0,0,0,8" />

                        <TextBlock Text="Image Colors Palette:" Margin="0,0,0,4" />
                        <ListBox x:Name="PaletteListBox" Height="150"
                                 ItemsSource="{Binding Path=PaletteItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 SelectedItem="{Binding Path=SelectedPaletteItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                 SelectionChanged="PaletteListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Border Width="16" Height="16" BorderBrush="Black" BorderThickness="1"
                                                Margin="0,0,6,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding DisplayColor}" />
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding HexValue}" VerticalAlignment="Center" Width="60" />
                                        <TextBlock Text="{Binding R, StringFormat=R:{0:D3}}" Foreground="Red"
                                                   Margin="5,0" />
                                        <TextBlock Text="{Binding G, StringFormat=G:{0:D3}}" Foreground="Green"
                                                   Margin="5,0" />
                                        <TextBlock Text="{Binding B, StringFormat=B:{0:D3}}" Foreground="DodgerBlue"
                                                   Margin="5,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected Color Editor -->
                        <Border Margin="0,10,0,0" Padding="5" BorderThickness="1" BorderBrush="Gray"
                                Visibility="{Binding Path=SelectedPaletteItem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel
                                DataContext="{Binding Path=SelectedPaletteItem, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <TextBlock Text="Edit Selected Color:" FontWeight="Bold" Margin="0,0,0,5" />

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="R:" Foreground="Red" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255"
                                            Value="{Binding R, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                            Margin="5,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding R}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="G:" Foreground="Green" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255"
                                            Value="{Binding G, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                            Margin="5,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding G}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="B:" Foreground="DodgerBlue"
                                               VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255"
                                            Value="{Binding B, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                            Margin="5,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding B}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Button Content="🔄 Reset Image" Click="ResetPalette_Click" Margin="0,0,10,0"
                                    Padding="10,5" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>