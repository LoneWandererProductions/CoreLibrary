<Window x:Class="Common.Dialogs.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Error"
        Width="480"
        MinWidth="420"
        MaxWidth="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>

            <!-- Read-only selectable TextBox -->
            <Style x:Key="SelectableTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>

            <!-- Expander Header -->
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Error Icon -->
            <Border Grid.Column="0"
                    Width="32" Height="32"
                    CornerRadius="16"
                    Background="{DynamicResource AccentBrush}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Top">
                <TextBlock Text="⚠️"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextEmphasisBrush}" />
            </Border>

            <!-- Title + Source -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="ErrorTitleText"
                         Style="{StaticResource SelectableTextStyle}"
                         FontWeight="Bold"
                         FontSize="15"
                         Foreground="{DynamicResource TextEmphasisBrush}" />

                <TextBox x:Name="ErrorSourceText"
                         Style="{StaticResource SelectableTextStyle}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Error Message -->
        <TextBox x:Name="ErrorMessageText"
                 Grid.Row="1"
                 Style="{StaticResource SelectableTextStyle}"
                 FontSize="13"
                 Margin="0,0,0,12"
                 MaxHeight="160" />

        <!-- Details -->
        <Expander x:Name="DetailsExpander"
                  Header="Details"
                  Grid.Row="2"
                  Margin="0,0,0,16">

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,8,0,0">

                <TextBox x:Name="ErrorDetailsText"
                         Style="{StaticResource SelectableTextStyle}"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         MaxHeight="180" />
            </Border>
        </Expander>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Button Content="📋 Copy Details"
                    HorizontalAlignment="Left"
                    Padding="12,5"
                    Click="CopyButton_Click"
                    ToolTip="Copy full error information to system clipboard" />

            <Button Content="OK"
                    HorizontalAlignment="Right"
                    Width="85"
                    Padding="0,5"
                    IsDefault="True"
                    IsCancel="True"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>