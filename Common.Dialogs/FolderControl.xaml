<UserControl x:Class="Common.Dialogs.FolderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             MinHeight="320"
             MinWidth="480"
             Padding="5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <!-- Quick Access sidebar -->
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <!-- Toolbar + tree -->
        </Grid.ColumnDefinitions>

        <!-- Quick Access sidebar -->
        <Border Grid.Column="0"
                BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="4">
                <TextBlock Text="Quick Access" FontSize="10"
                           Opacity="0.6" Margin="6,4,6,4" />
                <Button Content="🖥️  Desktop"
                        Command="{Binding DesktopCommand}" ToolTip="Jump to the Desktop folder" />
                <Button Content="💽  This PC"
                        Command="{Binding RootCommand}" ToolTip="Jump to the drive root" />
                <Button Content="📄  Documents" 
                        Command="{Binding DocsCommand}" ToolTip="Jump to Documents" />
                <Button Content="👤  Personal" 
                        Command="{Binding PersonalCommand}" ToolTip="Jump to your user profile folder" />
                <Button Content="🖼️  Pictures" 
                        Command="{Binding PicturesCommand}" ToolTip="Jump to Pictures" />
                <Separator Margin="4,8" />
                <Button Content="➕  New Folder"
                        Command="{Binding CreateFolderCommand}"
                        ToolTip="Create a new folder inside the current one" />
            </StackPanel>
        </Border>

        <!-- Toolbar + tree -->
        <Grid Grid.Column="2" Cursor="Hand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Nav buttons -->
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <!-- Path bar -->
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <!-- Tree: fills remaining space, so resizing the window actually helps -->
            </Grid.RowDefinitions>

            <!-- Navigation buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Content="◀"  Command="{Binding BackCommand}"
                        ToolTip="Back (Alt+Left)" Margin="0,0,4,0" />
                <Button Content="▶" Command="{Binding ForwardCommand}"
                        ToolTip="Forward (Alt+Right)" Margin="0,0,4,0" />
                <Button Content="▲ Up"  Command="{Binding UpCommand}"
                        ToolTip="Up to parent folder (Backspace)" Margin="0,0,10,0" />
                <Button Content="Go" Command="{Binding GoCommand}"
                        ToolTip="Navigate to the typed path (Enter)" Margin="0,0,4,0" />
                <Button Content="Open in Explorer" Command="{Binding ExplorerCommand}"
                        ToolTip="Open the current folder in Windows Explorer" />
            </StackPanel>

            <!-- Display and input Path -->
            <Grid Grid.Row="2" VerticalAlignment="Center" Cursor="Arrow">
                <TextBox x:Name="PathEntry"
             Text="{Binding LookUp, UpdateSourceTrigger=PropertyChanged}"
             Background="{DynamicResource InputBrush}"
             Foreground="{DynamicResource TextEmphasisBrush}"
             Padding="8,6"
             Visibility="Collapsed"
             LostFocus="PathEntry_LostFocus"
             KeyDown="PathEntry_KeyDown" />

                <Border x:Name="PathDisplayBorder"
            Background="{DynamicResource SurfaceBrush}" 
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" 
            CornerRadius="4">
                    <TextBlock x:Name="PathDisplay"
                   Text="{Binding Paths}"
                   TextTrimming="CharacterEllipsis"
                   Padding="8,6"
                   Cursor="IBeam"
                   ToolTip="Click to edit the path directly"
                   MouseDown="PathDisplay_MouseDown" />
                </Border>
            </Grid>

            <!-- TreeView -->
            <TreeView x:Name="FolderTree" Grid.Row="4" ItemsSource="{Binding FolderItems}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>
